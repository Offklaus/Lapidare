{
  "name": "lapidare-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:setup": "node --env-file-if-exists=.env src/db/setup.js",
    "db:seed": "node --env-file-if-exists=.env src/db/setup.js --seed-only",
    "db:migrate": "node --env-file-if-exists=.env src/db/setup.js --migrate-only",
    "db:setup:prod": "node --env-file=.env.production src/db/setup.js",
    "staff:create:prod": "node --env-file=.env.production src/scripts/staff.js create",
    "staff:create": "node --env-file-if-exists=.env src/scripts/staff.js create",
    "staff:password": "node --env-file-if-exists=.env src/scripts/staff.js password",
    "staff:deactivate": "node --env-file-if-exists=.env src/scripts/staff.js deactivate",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.13.1"
  }
}
