# Copie para .env e ajuste.

# Porta da API (as rotas ficam em http://localhost:3333/api)
PORT=3333

# Postgres: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# O banco "lapidare" é criado pelo `npm run db:setup` se ainda não existir.
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/lapidare

# Origens que podem chamar a API (separe por vírgula).
# Fora de produção, qualquer porta de localhost/127.0.0.1 também é aceita.
# Em produção (NODE_ENV=production) só valem as origens listadas aqui.
CORS_ORIGIN=http://localhost:5173

# Fuso do salão: datas e horários da API são sempre neste fuso
SALON_TIMEZONE=America/Sao_Paulo

# Intervalo entre inícios de horário, em minutos
SLOT_STEP_MIN=30

# Até quantas horas antes do horário a cliente pode cancelar sozinha pelo código (0 = até começar)
CANCEL_MIN_HOURS=24

# Quantos dias o login do painel da equipe dura
STAFF_SESSION_DAYS=7

# Login das clientes com Google (área "Minhas reservas").
# Crie em https://console.cloud.google.com → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web).
# Em "Origens JavaScript autorizadas", adicione o endereço do site (ex.: http://localhost:5173).
# Vazio = o botão "Entrar com Google" avisa que o login ainda não foi configurado.
GOOGLE_CLIENT_ID=

# Quantos dias o login da cliente dura
CUSTOMER_SESSION_DAYS=30

# Proxy na frente da API (Render, Nginx…): quantos saltos confiar para ler o IP real da cliente.
# Vazio = 1 em produção, nenhum no computador.
TRUST_PROXY=

# Até quantos dias à frente a cliente pode agendar
BOOKING_MAX_DAYS_AHEAD=60

# Quantos agendamentos futuros um mesmo WhatsApp pode ter ao mesmo tempo
BOOKING_MAX_ACTIVE_PER_PHONE=3

# Certificado do servidor Postgres (PEM), opcional. No Supabase: Database Settings → SSL → baixar.
# Com ele a conexão é criptografada e o servidor é conferido (a URL não precisa de sslmode).
# Em uma linha só, troque as quebras de linha por \n. Vazio = conexão como descrita na URL.
DATABASE_CA_CERT=

# Cabeçalho com o IP real da cliente, posto pela CDN. No Render (Cloudflare): cf-connecting-ip.
# Vazio = usa o IP da conexão (TRUST_PROXY). Sem isso, atrás do Render, várias clientes dividem os limites.
CLIENT_IP_HEADER=
