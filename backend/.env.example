# Copie para .env e ajuste.

# Porta da API (o front aponta para http://localhost:3333)
PORT=3333

# Postgres: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# O banco "lapidare" é criado pelo `npm run db:setup` se ainda não existir.
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/lapidare

# Origens que podem chamar a API (separe por vírgula)
CORS_ORIGIN=http://localhost:5173

# Fuso do salão: datas e horários da API são sempre neste fuso
SALON_TIMEZONE=America/Sao_Paulo

# Intervalo entre inícios de horário, em minutos
SLOT_STEP_MIN=30
